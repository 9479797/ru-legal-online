+    let h = head(x.title, '', null) + x.text.map((p) => '<p>' + esc(p) + '</p>').join('');
+    if (x.yes) h += '<div class="two"><div class="mini"><span class="lab" style="background:var(--g)">Не реклама</span>' + '<ul class="ml">' + x.no.map((s) => '<li>' + esc(s) + '</li>').join('') + '</ul>' + '</div><div class="mini"><span class="lab" style="background:var(--r)">Реклама</span>' + '<ul class="ml">' + x.yes.map((s) => '<li>' + esc(s) + '</li>').join('') + '</ul>' + '</div></div>';
+    if (x.parts) h += x.parts.map((pt) => '<div class="mini"><span class="lab" style="background:var(--brand)">' + esc(pt.title) + '</span><ul class="ml">' + pt.items.map((it) => '<li>' + esc(it) + '</li>').join('') + '</ul></div>').join('');
+    h += '<span style="font-size:13px;opacity:.92">Основание: ' + esc(x.basis) + '</span>';
+    openDlg(h, true);
+  } else if (t.dataset.themeSet) {
+    setTheme(t.dataset.themeSet);
+  }
+});
+
+function setTheme(m) {
+  if (m === 'auto') document.documentElement.removeAttribute('data-theme');
+  else document.documentElement.setAttribute('data-theme', m);
+  document.querySelectorAll('[data-theme-set]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === m)));
+  store.set('skhema-theme', m);
+}
+
+if (typeof ResizeObserver !== 'undefined') { const routeObserver = new ResizeObserver(() => requestAnimationFrame(syncRouteLayout)); routeObserver.observe($('.pathbar')); routeObserver.observe($('#steps')); }
+window.addEventListener('resize', () => requestAnimationFrame(syncRouteLayout));
+document.addEventListener('change', e => { if (e.target.id === 'publisher') { S.publisher = (D.bookPublishers || []).some(p => p.id === e.target.value) ? e.target.value : ''; render(); $('#publisher')?.focus(); } });
+$('#form').innerHTML = D.forms.map((f) => '<option value="' + f.id + '">' + esc(f.name) + '</option>').join('');
+$('#goal').innerHTML = D.goals.map((g) => '<option value="' + g.id + '">' + esc(g.name) + '</option>').join('');
+$('#form').value = S.form; $('#goal').value = S.goal;
+$('#form').addEventListener('change', (e) => { S.form = e.target.value; render(); });
+$('#goal').addEventListener('change', (e) => { S.goal = e.target.value; S.path = []; render(); });
+$('#scope').addEventListener('change', e => { const wasPromotion = S.scope === 'promotion'; S.scope = e.target.value; if (wasPromotion && S.scope !== 'promotion' && ['site','vkshop','market','donut','tgbot'].includes(S.path[2])) S.salePlace = S.path[2]; render(); });
+$('#format').addEventListener('change', e => { S.format = e.target.value; render(); });
+$('#sample').addEventListener('change', e => { S.sample = e.target.checked; render(); });
+$('#explain').innerHTML = D.explain.map((x) => '<button type="button" class="wbtn" data-explain="' + x.id + '">' + esc(x.title) + '</button>').join('');
+
+const savedTheme = store.get('skhema-theme', 'auto');
+if (savedTheme !== 'auto' || !document.documentElement.hasAttribute('data-theme')) setTheme(savedTheme);
+render();
+}
+</script>
+</body>
+</html>
