+<!DOCTYPE html>
+<html lang="ru">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Рискованные и запрещённые варианты — схема продвижения</title>
+<style>
+/* VOICE: спокойный наставник для эксперта-новичка, без юридического жаргона
+   IDEA: маршрутная карта — шаг за шагом от площадки к безопасной продаже
+   PICTURE: раскрывающиеся ряды карточек с цветной полосой риска
+   COLOUR and TYPE: сиренево-розовый фирменный градиент, изумруд, солнце, малина; Oswald + Manrope
+   LAYOUT: узкая строка пути сверху, шаги столбцом, градиентный подвал с пояснениями */
+:root{color-scheme:light dark;--bg:light-dark(#F6F6FB,#11121C);--ink:light-dark(#1F2033,#F1F2FA);--muted:light-dark(#5D6078,#AEB1C8);--card:light-dark(#FFFFFF,#1C1D2D);--line:light-dark(rgba(91,103,221,.28),rgba(174,181,255,.30));--pillink:light-dark(#4F5BD5,#B3B9FF);--stroke:light-dark(rgba(91,103,221,.08),rgba(174,181,255,.06));--bar:light-dark(rgba(246,246,251,.94),rgba(17,18,28,.94));--sh:light-dark(rgba(76,86,180,.10),rgba(0,0,0,.45));--soft:light-dark(#EEF0FC,#26283C);
+--brand:linear-gradient(120deg,#5B67DD 0%,#8A63DE 55%,#C3539F 100%);--g:linear-gradient(120deg,#0C8A6B 0%,#0B7F86 100%);--y:linear-gradient(120deg,#FFD452 0%,#FFB443 100%);--r:linear-gradient(120deg,#D7344C 0%,#C0266A 100%);--bright:linear-gradient(90deg,#8E9CFF 0%,#B49CF5 35%,#F0A2E5 70%,#FF3D8B 100%)}
+:root[data-theme=light]{color-scheme:light}:root[data-theme=dark]{color-scheme:dark}
+*{box-sizing:border-box;min-width:0}
+body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 Arial,system-ui,sans-serif;overflow-x:clip}
+button,select{font:inherit}
+button:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #8E9CFF;outline-offset:2px}
+.geo{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}
+.geo g{stroke:var(--stroke)}
+.top{position:sticky;top:0;z-index:5;background:var(--bar);backdrop-filter:blur(8px)}
+.top::before{content:"";display:block;height:3px;background:var(--bright)}
+.bar{display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;padding:10px max(3vw,16px)}
+.disp{font-family:"Arial Narrow",Arial,sans-serif;text-transform:uppercase;letter-spacing:.01em}
