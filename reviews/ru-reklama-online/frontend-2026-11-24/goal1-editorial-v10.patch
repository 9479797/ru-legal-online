+/* Редакторская карта первой цели: примеры выбираются по id, а не по словам в названии. */
+(function (root) {
+  const D=root.SCHEMA, base=root.CardHelp.get, methods={}, places={};
+  const pair=(explanation,a,aw,b,bw)=>({explanation,examples:[{label:'Пример ситуации',text:a,why:aw},{label:'Что меняется в другом случае',text:b,why:bw}],editorial:true});
+  const add=(ids,...copy)=>ids.split(' ').forEach(id=>{if(methods[id])throw Error('Повтор пояснения: '+id);methods[id]=pair(...copy);});
+  // Эти шесть пояснений уже содержат конкретные реплики и различают действия.
+  for(const id of ['author','bio','source','tglink','word','target']) {
+    const n=D.start.book.flatMap(p=>p.children||[]).find(n=>n.id===id);
+    methods[id]=Object.assign({},base(n),{editorial:true});
+  }
+  add('dm tg-reply vk-reply tt-dm',
+    'Вы отвечаете конкретному человеку, который сам спросил о материале. Можно ограничиться ответом; ссылка на покупку нужна только тогда, когда она помогает ответить на вопрос.',
+    'Читатель: «В памятке есть таблица расходов?» Автор: «Да, есть пустая таблица и заполненный пример».',
+    'Человек получил ответ. Если он спросит, где приобрести памятку, можно отдельно рассмотреть ответ со ссылкой на выбранное предложение.',
+    'После одного вопроса о таблице человеку каждую неделю присылают предложения купить другие материалы.',
+    'Это уже последующие рекламные сообщения. Один входящий вопрос не означает согласия на такую рассылку.');
+  add('tg-expert vk-expert yt-expert rt-expert tt-expert',
+    'Вы публикуете законченный разбор, которым читатель может воспользоваться без покупки. Упоминание платного материала внутри разбора нужно оценить отдельно.',
+    'Автор показывает три категории семейных расходов, заполняет таблицу на примере и объясняет, как повторить расчёт.',
+    'Читатель получил способ решения своей задачи. Проверьте также обложку, подпись и ссылки: они могут менять смысл публикации.',
+    'Вместо расчёта автор перечисляет достоинства платного гайда и говорит: «Хотите узнать способ — покупайте».',
+    'Это уже предложение продукта. Название «полезный разбор» не определяет рекламный характер само по себе.');
+  add('tg-post vk-post',
+    'Вы размещаете пост о своём материале: кому он предназначен, что в него входит и где посмотреть условия приобретения. Отдельно оценивается, является ли именно этот пост рекламой.',
+    '«Памятка по семейному бюджету: 12 страниц, таблица расходов и пример заполнения. Доступен файл PDF. Содержание и цена — по ссылке».',
+    'Ссылка должна открывать то же предложение: тот же материал, формат и условия. Для рекламного поста действуют требования выбранной площадки.',
+    'В посте обещан комплект печатных памяток, а ссылка ведёт только к покупке файла.',
+    'Человек получает другое предложение. Исправьте пост или страницу назначения.');
+  add('tg-posev vk-posev bl-paid',
+    'Вы договариваетесь с другим автором о рекламной публикации. Посев — это размещение такого поста в чужом канале или сообществе.',
+    'Автор канала о семейных финансах за плату публикует согласованный пост о вашей памятке со ссылкой на её описание.',
+    'До размещения нужно знать точную площадку, текст, дату и кто выполняет действия по маркировке и учёту рекламы.',
+    'Исполнитель обещает «продвижение», но не сообщает, в каком канале и какой пост выйдет.',
+    'Пока неизвестна сама публикация, нельзя оценить её площадку, содержание и рекламные обязанности сторон.');
+  add('tg-ads',
+    'Вы покупаете показы объявления через Telegram Ads. Читатель нажимает кнопку объявления и попадает в выбранный канал, бот или на поддерживаемую выбранным форматом страницу.',
